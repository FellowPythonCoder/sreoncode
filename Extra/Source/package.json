{
  "name": "sreon-search",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --features api",
    "source:zip": "python scripts/package-source.py",
    "api:build": "cargo build --manifest-path src-tauri/Cargo.toml --release --no-default-features --features api --bin sreon-api",
    "postdesktop:build": "node scripts/collect-builds.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.11.5"
  }
}
